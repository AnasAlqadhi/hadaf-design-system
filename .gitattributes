# Normalize all text files to LF in the repo. Prevents the CRLF/LF
# "whole file changed" diffs that were polluting the working tree.
* text=auto eol=lf

# Explicitly LF for the source we edit
*.js   text eol=lf
*.mjs  text eol=lf
*.jsx  text eol=lf
*.css  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.svg  text eol=lf

# Binary assets — never touch
*.png  binary
*.jpg  binary
*.jpeg binary
*.webp binary
*.ico  binary
*.woff binary
*.woff2 binary
